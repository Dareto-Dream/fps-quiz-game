# Server port. Defaults to 3000 when unset.
PORT=3000

# Public origin used for generated controller links and QR codes.
# Leave blank for local/LAN play so the server derives this from each request.
# Example: https://game.example.com
PUBLIC_BASE_URL=

# Comma-separated browser origins allowed to connect over HTTP and Socket.IO.
# Leave blank for local/LAN play. Set this in production to the exact public origin.
# Example: https://game.example.com,http://localhost:3000
ALLOWED_ORIGINS=
